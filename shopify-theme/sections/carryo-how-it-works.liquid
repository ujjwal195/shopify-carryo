<section id="how-it-works" class="section-block section-border section-tinted" data-craftsmanship>
  <div class="container">
    <div class="how-grid">
      <div class="how-steps">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="section-title">{{ section.settings.heading }}</h2>

        <div class="steps-list">
          {%- for block in section.blocks -%}
            <div class="step-item" {{ block.shopify_attributes }}>
              <h3 class="step-item__title">{{ block.settings.title }}</h3>
              <p class="step-item__desc">{{ block.settings.description }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <!-- Interactive Craftsmanship Viewer -->
      <div class="craft-panel">
        <div class="craft-panel__toolbar">
          <div class="tab-group" role="tablist">
            <button type="button" class="tab-btn is-active" data-craft-tab="interior" data-craft-title="Compact outside, spacious thermal chamber inside." data-craft-caption="Reinforced wipe-clean insulated lining traps radiant warmth evenly around every stainless steel container while guarding against transit spills.">
              Spacious Interior
            </button>
            <button type="button" class="tab-btn" data-craft-tab="back" data-craft-title="Front cord zip pocket & convenient back slip pocket." data-craft-caption="Keep your detachable inline-switch heating cord tucked neatly in the front zipper pocket, with quick-grab space in the rear slip pocket for napkins and cutlery.">
              Smart Pockets
            </button>
            <button type="button" class="tab-btn" data-craft-tab="kitDesk" data-craft-title="Simple inline switch heating right at your desk." data-craft-caption="Connect the detachable power cord to the side port, plug into a standard AC outlet, and switch it on—no water needed and zero microwave lines.">
              Plug &amp; Switch
            </button>
          </div>

          <div class="craft-colour-switcher">
            <span class="text-muted text-xs">Preview:</span>
            <button type="button" class="chip-btn" data-craft-colour="black">Black</button>
            <button type="button" class="chip-btn is-active" data-craft-colour="tan">Tan</button>
            <button type="button" class="chip-btn" data-craft-colour="grey">Grey</button>
          </div>
        </div>

        <div class="craft-panel__stage">
          <img
            src="{{ 'carryo-tan-interior.jpg' | asset_url }}"
            alt="Carryo tan — Spacious Interior"
            data-craft-img
            loading="lazy"
            width="800"
            height="600"
          >
        </div>

        <div class="craft-panel__caption">
          <h3 data-craft-heading>Compact outside, spacious thermal chamber inside.</h3>
          <p data-craft-text>Reinforced wipe-clean insulated lining traps radiant warmth evenly around every stainless steel container while guarding against transit spills.</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Carryo How It Works",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How Carryo Works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three effortless steps to hot home-cooked food."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "01. Pack your stainless steel containers"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Description",
          "default": "Fill the 3 containers (Carryo Large) or 2 containers (Carryo Small) with dal, sabzi, rice, or rotis."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carryo How It Works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "01. Pack your stainless steel containers",
            "description": "Fill the 3 containers (Carryo Large) or 2 containers (Carryo Small) with dal, sabzi, rice, or rotis. Place them inside the insulated bag and zip shut—your cord stays stowed in the front zip pocket."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "02. Plug into any wall socket & flip the switch",
            "description": "20 to 30 minutes before lunch, plug the detachable power cord into the side inlet and turn on the inline switch. The LED indicator lights up as Carryo gently heats your meal with zero added water."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "03. Unzip, eat hot, and wipe clean",
            "description": "Open to freshly heated home food right at your desk. Wash the stainless steel bowls normally and simply wipe the waterproof interior lining clean with a damp cloth."
          }
        }
      ]
    }
  ]
}
{% endschema %}
