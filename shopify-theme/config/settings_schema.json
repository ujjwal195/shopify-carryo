      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background (Obsidian)",
        "default": "#080809"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Card Surface",
        "default": "#111114"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border",
        "default": "#26262C"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (Carryo Gold)",
        "default": "#E0B052"
      },
      {
        "type": "color",
        "id": "color_accent_hover",
        "label": "Accent Hover",
        "default": "#ECC46E"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Primary Text (Ivory)",
        "default": "#F5F3EE"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Secondary Text (Muted)",
        "default": "#A1A1AA"
      }
    ]
  },
  {
    "name": "Cart Drawer & Shipping",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_cart_drawer",
