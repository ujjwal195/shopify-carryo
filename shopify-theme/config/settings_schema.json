      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free Shipping Threshold (in store currency)",
        "default": 1500
      },
      {
        "type": "text",
        "id": "promo_hint_text",
        "label": "Cart Drawer Promo Hint",
        "default": "Use code CARRYO10 at checkout for 10% off"
      },
      {
        "type": "text",
        "id": "support_contact",
        "label": "Support Contact Line",
        "default": "Support: care@carryo.store · Mon–Sat, 9 AM – 7 PM IST"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
